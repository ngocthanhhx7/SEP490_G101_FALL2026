          <mxGeometry as="geometry" x="15" y="2070" width="1110" height="220" />
        </mxCell>
        <mxCell id="caption-21" value="alt [nonretryable failure OR attempts exhausted]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="2077" width="1010" height="32" />
        </mxCell>
        <mxCell id="msg-21" value="21: FAILED, safe failureCode, clear lease; retain durable&#10;row/history" style="html=0;verticalAlign=bottom;fontSize=11;strokeColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="295" y="2190" />
            <mxPoint as="targetPoint" x="480" y="2190" />
          </mxGeometry>
        </mxCell>
        <mxCell id="act-21" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="475" y="2190" width="10" height="26" />
        </mxCell>
        <mxCell id="msg-22" value="22: No automatic resend. A mail failure does not roll back the&#10;already saved application" style="html=0;verticalAlign=bottom;fontSize=11;strokeColor=#000000;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="295" y="2248" />
            <mxPoint as="targetPoint" x="105" y="2248" />
          </mxGeometry>
        </mxCell>
        <mxCell id="scope-note" value="Source: application-mail.service.js and application-mail.job.js. ACCEPTED, UNKNOWN, PENDING, FAILED and SKIPPED are distinct states. An expired SENDING lease cannot safely prove delivery failure. Operation ID is stable across known-safe retries; it does not guarantee SMTP deduplication. Unknown results require reconciliation, not blind resend." style="shape=note;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="2361" width="1100" height="145" />
        </mxCell>
