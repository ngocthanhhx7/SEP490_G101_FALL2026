        </mxCell>
        <mxCell id="msg-16" value="16: Count accepted. SMTP acceptance does not prove inbox&#10;delivery" style="html=0;verticalAlign=bottom;fontSize=11;strokeColor=#000000;endArrow=open;dashed=1;" edge="1" parent="1">
