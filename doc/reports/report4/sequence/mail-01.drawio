        <mxCell id="msg-6" value="6: Expired SENDING leases -&gt; UNKNOWN / ACKNOWLEDGEMENT_UNKNOWN;&#10;never automatically requeue" style="html=0;verticalAlign=bottom;fontSize=11;strokeColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1">
