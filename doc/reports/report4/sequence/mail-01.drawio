          <mxGeometry as="geometry" x="475" y="1688" width="10" height="26" />
        </mxCell>
        <mxCell id="msg-18" value="18: Stop automatic retry for this row. Operator reconciles&#10;actual provider/recipient evidence; do not invent delivery" style="html=0;verticalAlign=bottom;fontSize=11;strokeColor=#000000;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="295" y="1746" />
            <mxPoint as="targetPoint" x="105" y="1746" />
