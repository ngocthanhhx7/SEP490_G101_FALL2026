          <mxGeometry as="geometry" x="15" y="1568" width="1110" height="220" />
        </mxCell>
        <mxCell id="caption-17" value="alt [uncertain response, timeout or crash after possible SMTP acceptance]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="1575" width="1010" height="32" />
        </mxCell>
        <mxCell id="msg-17" value="17: Response uncertain=true -&gt; UNKNOWN with safe code; an&#10;expired lease is also UNKNOWN on a later tick" style="html=0;verticalAlign=bottom;fontSize=11;strokeColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
