          <mxGeometry as="geometry" x="15" y="1819" width="1110" height="220" />
        </mxCell>
        <mxCell id="caption-19" value="alt [known safe retryable failure AND attempts &lt; 3]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="1826" width="1010" height="32" />
        </mxCell>
