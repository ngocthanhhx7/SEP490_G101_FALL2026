          </mxGeometry>
        </mxCell>
        <mxCell id="scope-note" value="DESIGN_PENDING_RUNTIME. Proposed interactions and technical DTO limits, not an existing deployed endpoint, provider acceptance or approved missing business policy. Every mutation rechecks current session/role/CSRF; user-supplied actor/state is ignored. External delivery/transfer is outside database transactions. Approval and rejection are alternative commands; expiry is a separate bounded worker. No current startup job or route is claimed. Fee/cancellation/cutoff treatment is disabled until explicitly approved." style="shape=note;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1782" width="1100" height="145" />
        </mxCell>
