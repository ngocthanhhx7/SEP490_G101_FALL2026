        <mxCell id="scope-note" value="Source: auth.controller.js deleteSessionsCurrent and session.service.js. No generic payload-fingerprint command store or business transaction is implied by logout. Login creates a new session through UC-02; logout does not send OTP or delete the account." style="shape=note;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=12;spacing=10;" vertex="1" parent="1">
