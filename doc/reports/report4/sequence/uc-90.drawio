            <mxPoint as="targetPoint" x="105" y="903" />
          </mxGeometry>
        </mxCell>
        <mxCell id="scope-note" value="DESIGN_PENDING_RUNTIME. Proposed interactions and technical DTO limits, not an existing deployed endpoint, provider acceptance or approved missing business policy. Every mutation rechecks current session/role/CSRF; user-supplied actor/state is ignored. External delivery/transfer is outside database transactions. Current assigned-care accessNotes() does not itself prove audit persistence. This query is read-only. Retention/TTL and audit-reader permissions need review; raw notes, keys and private address data never appear in audit DTO." style="shape=note;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="1029" width="1100" height="145" />
        </mxCell>
