        <mxCell id="msg-1" value="1: POST /api/v1/contact/messages with&#10;name/phone/email/topic/message/consent" style="html=0;verticalAlign=bottom;fontSize=11;strokeColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1">
