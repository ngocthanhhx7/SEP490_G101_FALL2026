        <mxCell id="ref-edge-1-0" value="" style="edgeStyle=none;rounded=0;html=0;exitX=1;exitY=0.6554054054054054;exitPerimeter=0;entryX=0;entryY=0.725;entryPerimeter=0;startArrow=ERzeroToMany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#22B8F0;strokeWidth=1.2;" edge="1" source="StockLedgerEntry" target="ref-1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="854" y="371" />
              <mxPoint x="854" y="283" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="design-note-0" value="DESIGN_PENDING_RUNTIME — scope&#10;UC-70 / UC-71 / UC-95&#10;Append-only event/source identity. Current product/order snapshots remain authoritative until reviewed migration. Ledger must be committed&#10;with guarded stock update; never rewrite an old receipt.&#10;Constraints/indexes are proposed, not provisioned; no live acceptance claimed." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="594" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-1" value="State / transaction rules&#10;Append-only; no committed event update/delete. Product/order snapshots retain authority until reviewed migration.&#10;RECEIPT deltaOnHand&gt;0/deltaHeld=0; ADJUSTMENT nonzero onHand/held=0. SALE/RETURN deltas match exact guarded order transition; faulty goods&#10;never restock.&#10;Ledger event, guarded Product.version increment and source transition commit together; same source with changed deltas conflicts, never&#10;increments again." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="748" width="1320" height="149" />
        </mxCell>
        <mxCell id="design-note-2" value="Proposed indexes&#10;{&quot;kind&quot;: 1, &quot;sourceRef&quot;: 1, &quot;sourceVersion&quot;: 1, &quot;productId&quot;: 1} {&quot;unique&quot;: true} — One stock effect per source version/product/event kind&#10;{&quot;productId&quot;: 1, &quot;recordedAt&quot;: 1, &quot;_id&quot;: 1} {} — Append-only product audit history" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="921" width="1320" height="95" />
        </mxCell>
        <mxCell id="design-note-3" value="eventIdentity&#10;{&quot;fields&quot;: [&quot;kind&quot;, &quot;sourceRef&quot;, &quot;sourceVersion&quot;, &quot;productId&quot;], &quot;canonicalId&quot;: &quot;SHA256 typed tuple&quot;, &quot;atomicity&quot;: &quot;Unique source claim plus&#10;guarded product update in same transaction; collision with different effect is conflict.&quot;}" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1040" width="1320" height="95" />
        </mxCell>
        <mxCell id="design-note-4" value="Reference key/type and join rules&#10;productId -&gt; products._id [ObjectId / ObjectId]; Resolve under current owner/role/state and transaction guards.&#10;actorId -&gt; users._id [ObjectId / ObjectId]; Resolve under current owner/role/state and transaction guards.&#10;sourceRef -&gt; proposed goodsreceipts OR productorders OR proposed stockadjustments._id [String / ObjectId serialized as String]; kind&#10;discriminates RECEIPT-&gt;goodsreceipt, SALE/RETURN-&gt;productorder, ADJUSTMENT-&gt;stockadjustment; include sourceVersion/productId." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1159" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-5" value="Release gates&#10;Stock event mapping, reversal rules and migration authority require independent review.&#10;No TTL/retention deletion assumed for financial/stock history." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1313" width="1320" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
