        <mxCell id="design-note-0" value="DESIGN_PENDING_RUNTIME — scope&#10;UC-95&#10;Admin only; decrease cannot exceed sellable quantity, stock cannot go below zero. Atomic version/quantity guard plus immutable reason/audit;&#10;no change to earlier receipts.&#10;Constraints/indexes are proposed, not provisioned; no live acceptance claimed." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="665" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-1" value="State / transaction rules&#10;Admin-only APPLIED record; DAMAGED/LOST/INTERNAL_USE require negative delta. RECEIPT_CORRECTION requires source receipt and evidenced signed&#10;delta.&#10;Expected stock version, sellable predicate, adjustment, ledger and command result commit atomically; stale/insufficient stock conflicts.&#10;No editing historic receipts, arbitrary positive stock or automatic unexplained balance correction." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="819" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-2" value="Proposed indexes&#10;{&quot;actorId&quot;: 1, &quot;idempotencyKey&quot;: 1} {&quot;unique&quot;: true} — Initial adjustment submit scope&#10;{&quot;ledgerRef&quot;: 1} {&quot;unique&quot;: true} — One applied adjustment per ledger event&#10;{&quot;productId&quot;: 1, &quot;createdAt&quot;: -1, &quot;_id&quot;: -1} {} — Product adjustment history" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="973" width="1320" height="111" />
        </mxCell>
        <mxCell id="design-note-3" value="commandContract&#10;{&quot;status&quot;: &quot;DESIGN_PENDING_RUNTIME&quot;, &quot;submitIdentity&quot;: [&quot;actorId&quot;, &quot;idempotencyKey&quot;], &quot;actionIdentity&quot;:&#10;&quot;SHA256([actorId,operation,aggregateId,actionSpecificKey])&quot;, &quot;fingerprint&quot;: &quot;Canonical operation/resource/expectedVersion/payload SHA256;&#10;changed payload with same identity -&gt;409; same command may return stored allowlisted result after current authorization checks.&quot;,&#10;&quot;atomicity&quot;: &quot;Mutation, source claims/events and immutable command result in one Mongo transaction; no external send/transfer inside it.&#10;Later decisions use separate keys.&quot;, &quot;resultStore&quot;: &quot;Reviewed command-store operation adapter: unique _id, fingerprint, result, createdAt.&#10;New operation is not claimed wired.&quot;, &quot;retry&quot;: &quot;Unknown HTTP acknowledgement retries original key/payload; external outcome needs&#10;authoritative reconciliation.&quot;}" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1108" width="1320" height="187" />
        </mxCell>
        <mxCell id="design-note-4" value="Reference key/type and join rules&#10;productId -&gt; products._id [ObjectId / ObjectId]; Resolve under current owner/role/state and transaction guards.&#10;actorId -&gt; users._id [ObjectId / ObjectId]; Resolve under current owner/role/state and transaction guards.&#10;ledgerRef -&gt; proposed stockledgerentries._id [String / String]; Resolve under current owner/role/state and transaction guards.&#10;sourceReceiptId -&gt; proposed goodsreceipts._id [ObjectId / ObjectId]; Required for RECEIPT_CORRECTION and same product line; original receipt&#10;immutable." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1319" width="1320" height="149" />
        </mxCell>
        <mxCell id="design-note-5" value="Release gates&#10;Stock correction evidence/authority and initial ledger adoption need reviewed acceptance; no migration is implemented." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1492" width="1320" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
