        <mxCell id="design-note-0" value="DESIGN_PENDING_RUNTIME — scope&#10;UC-12 / care safety&#10;Private contact. Owner-authorized, explicit user-provided relationship; no inferred identity. Keep separately encrypted from public sitter&#10;profile.&#10;Constraints/indexes are proposed, not provisioned; no live acceptance claimed." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="492" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-1" value="State / transaction rules&#10;ACTIVE -&gt; ARCHIVED through owned expected-version command; no global unique phone/name because a contact can be shared by owners.&#10;Explicit owner-entered contact and relationship only; no inferred identity. Archived entries cannot be selected for a new booking;&#10;authorized prior snapshots are immutable." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="646" width="1320" height="111" />
        </mxCell>
        <mxCell id="design-note-2" value="Proposed indexes&#10;{&quot;ownerId&quot;: 1, &quot;state&quot;: 1, &quot;updatedAt&quot;: -1, &quot;_id&quot;: -1} {} — Owner private contact list" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="781" width="1320" height="95" />
        </mxCell>
        <mxCell id="design-note-3" value="commandContract&#10;{&quot;status&quot;: &quot;DESIGN_PENDING_RUNTIME&quot;, &quot;identity&quot;: &quot;SHA256([ownerId,EMERGENCY_CONTACT_CREATE|UPDATE|ARCHIVE,resourceId-or-NEW,key])&quot;,&#10;&quot;storage&quot;: &quot;Unique command identity, canonical fingerprint and result in same transaction; no phone/name uniqueness.&quot;, &quot;retry&quot;: &quot;Same&#10;original key/payload after current owner authorization; different payload conflicts.&quot;}" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="900" width="1320" height="111" />
        </mxCell>
        <mxCell id="design-note-4" value="Reference key/type and join rules&#10;ownerId -&gt; users._id [ObjectId / ObjectId]; Owned active Customer; never reuse public sitter profile contact." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1035" width="1320" height="95" />
        </mxCell>
        <mxCell id="design-note-5" value="Release gates&#10;Private-contact consent, retention/deletion and new command adapter need approved release acceptance; no public projection or bulk backfill." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1154" width="1320" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
