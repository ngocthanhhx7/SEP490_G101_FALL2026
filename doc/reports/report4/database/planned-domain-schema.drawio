          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="908" y="371" />
              <mxPoint x="908" y="428" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="design-note-0" value="DESIGN_PENDING_RUNTIME — scope&#10;UC-79&#10;Approval writes date exclusions and replacement/handover events transactionally. Near-term withdrawal follows Staff decision; no automatic&#10;salary reduction. Dates use Asia/Ho_Chi_Minh.&#10;Constraints/indexes are proposed, not provisioned; no live acceptance claimed." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="696" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-1" value="State / transaction rules&#10;SUBMITTED -&gt; APPROVED | REJECTED | WITHDRAWN with current version; terminal states cannot transition again.&#10;APPROVE atomically updates date exclusions, availability version, affected visit handover/reassignment intents and command result;&#10;overlap/occupancy rechecked under employee guard.&#10;Near-term withdrawal requires authorized decision; no automatic assigned-visit cancellation or salary reduction." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="850" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-2" value="Proposed indexes&#10;{&quot;sitterId&quot;: 1, &quot;commandKey&quot;: 1} {&quot;unique&quot;: true} — Deduplicate initial submit; fingerprint must match&#10;{&quot;sitterId&quot;: 1, &quot;state&quot;: 1, &quot;startLocalDate&quot;: 1, &quot;endLocalDate&quot;: 1} {} — Overlap review; not a date-range exclusion guarantee&#10;{&quot;state&quot;: 1, &quot;createdAt&quot;: 1, &quot;_id&quot;: 1} {} — Bounded decision queue" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1004" width="1320" height="111" />
        </mxCell>
        <mxCell id="design-note-3" value="commandContract&#10;{&quot;status&quot;: &quot;DESIGN_PENDING_RUNTIME&quot;, &quot;submitIdentity&quot;: [&quot;sitterId&quot;, &quot;commandKey&quot;], &quot;actionIdentity&quot;:&#10;&quot;SHA256([actorId,operation,aggregateId,actionSpecificKey])&quot;, &quot;fingerprint&quot;: &quot;Canonical operation/resource/expectedVersion/payload SHA256;&#10;changed payload with same identity -&gt;409; same command may return stored allowlisted result after current authorization checks.&quot;,&#10;&quot;atomicity&quot;: &quot;Mutation, source claims/events and immutable command result in one Mongo transaction; no external send/transfer inside it.&#10;Later decisions use separate keys.&quot;, &quot;resultStore&quot;: &quot;Reviewed command-store operation adapter: unique _id, fingerprint, result, createdAt.&#10;New operation is not claimed wired.&quot;, &quot;retry&quot;: &quot;Unknown HTTP acknowledgement retries original key/payload; external outcome needs&#10;authoritative reconciliation.&quot;}" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1139" width="1320" height="187" />
        </mxCell>
        <mxCell id="design-note-4" value="Reference key/type and join rules&#10;sitterId -&gt; users._id [ObjectId / ObjectId]; Active PET_SITTER with valid signed contract.&#10;sitterId -&gt; employeeavailabilities._id [ObjectId / String]; Explicit hex-string conversion to employeeavailabilities._id; compare&#10;availabilityVersion.&#10;affectedVisitVersions[].visitId -&gt; visits._id [ObjectId / ObjectId]; Assigned sitter and captured visit version must still match at&#10;decision.&#10;decisionBy -&gt; users._id [ObjectId / ObjectId]; Current authorized Staff/Admin for approval/rejection; null on pending/owner withdrawal." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1350" width="1320" height="168" />
        </mxCell>
        <mxCell id="design-note-5" value="Release gates&#10;Approved lead time, maximum range and near-term withdrawal/handover cutoffs required; no guessed constants.&#10;Employee/visit concurrency, notifications and command namespace need independent acceptance." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1542" width="1320" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
