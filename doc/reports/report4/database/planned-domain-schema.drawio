          <mxGeometry as="geometry" x="0" y="36" width="220" height="44" />
        </mxCell>
        <mxCell id="ref-1-type" value="ObjectId" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#202020;spacingLeft=7;strokeColor=none;" vertex="1" parent="ref-1">
