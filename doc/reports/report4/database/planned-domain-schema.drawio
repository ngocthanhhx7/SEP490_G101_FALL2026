        <mxCell id="ref-edge-2-1" value="" style="edgeStyle=none;rounded=0;html=0;exitX=1;exitY=0.5846905537459284;exitPerimeter=0;entryX=0;entryY=0.725;entryPerimeter=0;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#22B8F0;strokeWidth=1.2;" edge="1" source="BookingChangeRequest" target="ref-2" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="926" y="439" />
              <mxPoint x="926" y="428" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="design-note-0" value="DESIGN_PENDING_RUNTIME — scope&#10;UC-84 / UC-85&#10;Time-only change preserves price snapshot. Request/decision/expiry use approved versioned cutoffs and occupancy recheck; unresolved policy&#10;is not replaced by guessed constants.&#10;Constraints/indexes are proposed, not provisioned; no live acceptance claimed." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="764" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-1" value="State / transaction rules&#10;PENDING -&gt; APPROVED | REJECTED | EXPIRED using request.version and sourceVisitVersion.&#10;APPROVE rechecks expiry, eligibility, occupancy, payment/case restrictions and current customer ownership; updates visit scheduling effects&#10;transactionally while preserving immutable price snapshot.&#10;Changed source visit, competing request or unavailable slot returns conflict; rejected/expired request reserves no occupancy." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="918" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-2" value="Proposed indexes&#10;{&quot;customerId&quot;: 1, &quot;idempotencyKey&quot;: 1} {&quot;unique&quot;: true} — Initial submission replay scope&#10;{&quot;visitId&quot;: 1} {&quot;unique&quot;: true, &quot;partialFilterExpression&quot;: {&quot;state&quot;: &quot;PENDING&quot;}} — One pending change per visit&#10;{&quot;state&quot;: 1, &quot;expiresAt&quot;: 1, &quot;_id&quot;: 1} {} — Bounded expiry sweep" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1072" width="1320" height="111" />
        </mxCell>
        <mxCell id="design-note-3" value="commandContract&#10;{&quot;status&quot;: &quot;DESIGN_PENDING_RUNTIME&quot;, &quot;submitIdentity&quot;: [&quot;customerId&quot;, &quot;idempotencyKey&quot;], &quot;actionIdentity&quot;:&#10;&quot;SHA256([actorId,operation,aggregateId,actionSpecificKey])&quot;, &quot;fingerprint&quot;: &quot;Canonical operation/resource/expectedVersion/payload SHA256;&#10;changed payload with same identity -&gt;409; same command may return stored allowlisted result after current authorization checks.&quot;,&#10;&quot;atomicity&quot;: &quot;Mutation, source claims/events and immutable command result in one Mongo transaction; no external send/transfer inside it.&#10;Later decisions use separate keys.&quot;, &quot;resultStore&quot;: &quot;Reviewed command-store operation adapter: unique _id, fingerprint, result, createdAt.&#10;New operation is not claimed wired.&quot;, &quot;retry&quot;: &quot;Unknown HTTP acknowledgement retries original key/payload; external outcome needs&#10;authoritative reconciliation.&quot;}" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1207" width="1320" height="187" />
        </mxCell>
        <mxCell id="design-note-4" value="Reference key/type and join rules&#10;bookingId -&gt; bookings._id [ObjectId / ObjectId]; Check Customer owner, visit.bookingId and current role/state; decision actor must be&#10;authorized operator.&#10;visitId -&gt; visits._id [ObjectId / ObjectId]; Check Customer owner, visit.bookingId and current role/state; decision actor must be authorized&#10;operator.&#10;customerId -&gt; users._id [ObjectId / ObjectId]; Check Customer owner, visit.bookingId and current role/state; decision actor must be&#10;authorized operator.&#10;decisionBy -&gt; users._id [ObjectId / ObjectId]; Check Customer owner, visit.bookingId and current role/state; decision actor must be&#10;authorized operator." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1418" width="1320" height="206" />
        </mxCell>
        <mxCell id="design-note-5" value="Release gates&#10;Approved change lead time, expiry and any financial/cancellation treatment are unresolved release gates; no guessed fee/cutoff.&#10;Review operator authority and customer/employee confirmation protocol before enabling." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1648" width="1320" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
