        <mxCell id="design-note-0" value="DESIGN_PENDING_RUNTIME — scope&#10;UC-90&#10;Record actor/time/resource/decision, never note text, key code or address secrets. Current assigned-care reader does not itself establish&#10;this audit event.&#10;Constraints/indexes are proposed, not provisioned; no live acceptance claimed." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="492" width="1320" height="130" />
        </mxCell>
        <mxCell id="design-note-1" value="State / transaction rules&#10;Append-only decision event, not assignment/financial mutation.&#10;GRANTED checks current assignment/handover, acknowledged exact care snapshot and source window [startAt-1h,endAt); log safe metadata only.&#10;If mandatory audit write fails, fail closed before returning note text; DENIED may lack source version/hash when never authorized/loaded.&#10;Never invent them.&#10;action READ_GRANTED requires reasonCode=GRANTED; READ_DENIED requires a non-GRANTED safe reason. No note text appears in either record." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="646" width="1320" height="149" />
        </mxCell>
        <mxCell id="design-note-2" value="Proposed indexes&#10;{&quot;actorId&quot;: 1, &quot;visitId&quot;: 1, &quot;correlationId&quot;: 1, &quot;action&quot;: 1} {&quot;unique&quot;: true} — Deduplicate one evaluated access event&#10;{&quot;visitId&quot;: 1, &quot;occurredAt&quot;: -1, &quot;_id&quot;: -1} {} — Authorized visit audit&#10;{&quot;actorId&quot;: 1, &quot;occurredAt&quot;: -1, &quot;_id&quot;: -1} {} — Authorized actor audit" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="819" width="1320" height="111" />
        </mxCell>
        <mxCell id="design-note-3" value="eventIdentity&#10;{&quot;fields&quot;: [&quot;actorId&quot;, &quot;visitId&quot;, &quot;correlationId&quot;, &quot;action&quot;], &quot;atomicity&quot;: &quot;Persist evaluated event before releasing protected response;&#10;same event retry deduplicates. Later reauthorization uses new correlation ID.&quot;}" style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="954" width="1320" height="95" />
        </mxCell>
        <mxCell id="design-note-4" value="Reference key/type and join rules&#10;visitId -&gt; visits._id [ObjectId / ObjectId]; READ_GRANTED resolves assigned current visit; READ_DENIED may retain only attempted&#10;syntactically valid ID, not an invented source.&#10;actorId -&gt; users._id [ObjectId / ObjectId]; Authenticated requesting actor; anonymous failures remain technical access logs." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1073" width="1320" height="111" />
        </mxCell>
        <mxCell id="design-note-5" value="Release gates&#10;Privacy retention/TTL (none assumed), authorized audit readers and fail-closed behavior require review.&#10;Current assigned-care reader is not claimed to emit this proposed event." style="shape=note;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="1208" width="1320" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
