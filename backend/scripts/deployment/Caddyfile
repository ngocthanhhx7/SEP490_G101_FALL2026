(paw_site) {
    encode zstd gzip
    request_body {
        max_size 10MB
    }
    @backend path /api /api/* /health /ready
    handle @backend {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-For {client_ip}
        }
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

pawworldvn.shop, www.pawworldvn.shop, api.pawworldvn.shop {
    import paw_site
}

http://127.0.0.1:8080 {
    import paw_site
}
