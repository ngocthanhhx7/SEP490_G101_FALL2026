{
  "name": "paw-world-care-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.22.1", "npm": "11.19.1" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "lint": "eslint src scripts tests eslint.config.js jest.config.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "npm test -- --selectProjects unit",
    "test:integration": "npm test -- --selectProjects integration",
    "seed:admin": "node --env-file-if-exists=.env scripts/seeds/admin.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "9.11.2",
    "nodemailer": "10.1.1"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "mongodb-memory-server-core": "11.3.0",
    "supertest": "7.3.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": { "js-yaml": "4.3.2" }
  }
}
