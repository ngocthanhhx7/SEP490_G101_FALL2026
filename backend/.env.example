NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGO_URI="mongodb+srv://<db-user>:<url-encoded-password>@<atlas-cluster-host>/?retryWrites=true&w=majority"
MONGO_DB=paw_world_care_dev
MONGO_CONNECT_TIMEOUT_MS=5000
READINESS_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY_HOPS=0
# Explicitly opt in only when running seed:admin on a disposable dev database.
ALLOW_DEV_ADMIN_SEED=false
# Optional P11 SMTP adapter; P34 must install/inject the transport before enabling.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.invalid
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=2
