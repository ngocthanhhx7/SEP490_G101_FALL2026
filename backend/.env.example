NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=pwc-local
MONGO_DB=paw_world_care_dev
# Local: run scripts/start-local-mongo.ps1 before starting backend.
# Staging preflight only: remote Atlas or authenticated loopback EC2 Mongo.
STAGING_MONGO_TOPOLOGY=remote
MONGO_CONNECT_TIMEOUT_MS=5000
READINESS_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY_HOPS=0
# Explicitly opt in only when running seed:admin on a disposable dev database.
ALLOW_DEV_ADMIN_SEED=false
# P34 authentication routes stay unmounted unless explicitly enabled.
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true. Use separate locally generated values.
OTP_HMAC_SECRET=
SESSION_TOKEN_SECRET=
SESSION_CSRF_SECRET=
CONTACT_LOOKUP_SECRET=
# CONTACT_ENCRYPTION_KEY must contain exactly 32 UTF-8 bytes.
CONTACT_ENCRYPTION_KEY=
# P11 SMTP adapter; remains disabled until a real provider and sender are configured.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.invalid
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=2
# Destination for public contact requests; leave empty until the project inbox is confirmed.
# Requires EMAIL_ENABLED=true and the SMTP settings above; never use a visitor-controlled recipient.
CONTACT_INBOX_EMAIL=
# P12 eSMS adapter; remains disabled until credentials and an approved Brandname exist.
SMS_ENABLED=false
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_OTP_TEMPLATE=Ma xac nhan cua ban la {code}
SMS_TIMEOUT_MS=10000
ESMS_SANDBOX=false

# Sitter recommendations only; pricing/pet-care use AUTH_ENABLED independently.
AI_ENABLED=false
# Trusted self-hosted OSRM endpoint; no public demo server configured automatically.
AI_ROUTING_URL=
# Optional dataset rectangle west,south,east,north. Set only for the deployed map.
AI_ROUTING_BOUNDS=
# Vietmap-only setup: Search v4, Place v4 and Matrix v4 share the REST key.
# Optional alternatives: osrm needs AI_ROUTING_URL; google needs its own key/billing.
MAPS_ROUTING_PROVIDER=vietmap
MAPS_ENABLED=false
MAPS_SEARCH_PROVIDER=vietmap
# Server REST keys only. Never expose these as VITE_* variables.
# Optional: leave blank when both providers above are vietmap.
GOOGLE_MAPS_SERVER_KEY=
VIETMAP_REST_API_KEY=
# Separate Tilemap key for authenticated embedded maps; never sent to browsers.
VIETMAP_TILEMAP_KEY=
VISIT_TRAVEL_ENABLED=false

# Private owner-only image storage. Disabled by default; credentials stay on the backend.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MAX_IMAGES_PER_USER=20

# payOS payment links and signed webhooks (server only).
# Leave disabled until all three credentials belong to the same payOS payment channel.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Milliseconds, supported range 100-30000; no automatic payment retries.
PAYOS_TIMEOUT_MS=10000
# Production BOOKING_WEB_ORIGIN=https://pawworldvn.shop
# Set the channel webhook in payOS: https://pawworldvn.shop/api/v1/payments/payos/webhook
# The webhook needs AUTH_ENABLED=true and FINANCE_SOURCES_ENABLED=true.
# Checkout additionally needs BOOKING_CHECKOUT_ENABLED=true and provisioned storage.
# Local webhook testing needs a public HTTPS tunnel; payOS cannot reach localhost.

# Booking/payment and employee scheduling: provision the documented storage first.
FINANCE_SOURCES_ENABLED=false
BOOKING_CHECKOUT_ENABLED=false
BOOKING_WEB_ORIGIN=http://localhost:5173
BOOKING_FACILITY_ADDRESS=Sample Paw World Care facility address
# Confirmed GeoJSON coordinate order: [longitude,latitude]. Leave blank until checked.
BOOKING_FACILITY_COORDINATES=
EMPLOYEE_SCHEDULING_ENABLED=false
EMPLOYEE_DISPATCH_AGENT_ENABLED=false

# Private applicant identity/certificate images: separate bucket and credentials.
# Default closed; enabling general R2 photos never enables identity intake.
SITTER_DOCUMENTS_ENABLED=false
SITTER_DOCUMENTS_R2_ACCOUNT_ID=
SITTER_DOCUMENTS_R2_BUCKET=
SITTER_DOCUMENTS_R2_ACCESS_KEY_ID=
SITTER_DOCUMENTS_R2_SECRET_ACCESS_KEY=
SITTER_DOCUMENTS_MAX_FILES_PER_USER=20
