NODE_ENV=development
PORT=3000

# Local MongoDB replica set from docker-compose.yml
MONGODB_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Express trust proxy setting. Keep loopback for local development.
# In deployment, set this to the trusted proxy hop count or trusted CIDR(s).
TRUST_PROXY=loopback

# Durations accept ms, s, m, or h. Contact quota is <count>/<duration>.
OTP_TTL=5m
PENDING_TTL=30m
MAX_WRONG_OTP=5
MAX_RESEND=4
CONTACT_QUOTA=5/60m
RESEND_COOLDOWN=60s
REGISTER_IP_LIMIT=20
RESEND_IP_LIMIT=20
VERIFY_IP_LIMIT=60
LOGIN_REQUEST_IP_LIMIT=20
LOGIN_VERIFY_IP_LIMIT=60
SITTER_APPLICATION_IP_LIMIT=10
SITTER_RESEND_IP_LIMIT=10
SITTER_VERIFY_IP_LIMIT=30
IP_RATE_WINDOW=60m
LOGIN_SESSION_TTL=30d

# Default bounded provider call timeout: 10 seconds.
PROVIDER_TIMEOUT_MS=10000
RESERVATION_TTL=30s

# Generate a unique random secret for each environment; never commit the real value.
OTP_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional in development; production must use a unique 32-byte hex key for private applicant files.
PET_SITTER_PII_ENCRYPTION_KEY=

# Keep mock for local development; choose real providers only after setting credentials below.
OTP_EMAIL_PROVIDER=mock
OTP_SMS_PROVIDER=mock

# Gmail SMTP: use a Google App Password (requires 2-Step Verification), not your account password.
# Set OTP_EMAIL_PROVIDER=gmail and fill these values in your private .env.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# eSMS.vn: Brandname and the exact template must be approved by eSMS/carriers.
# Set OTP_SMS_PROVIDER=esms and fill these values in your private .env.
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_CONTENT_TEMPLATE=
# 1 only validates integration without delivering a message; 0 sends real SMS.
ESMS_SANDBOX=0
ESMS_IS_UNICODE=0
